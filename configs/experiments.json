      "backend": "python",
      "entry": "experiments/table1_truthfulqa/table1_run_generation.py",
      "arguments": [
        "--model",
        "{model}",
        "--model-dir",
        "{model_dir}",
        "--work-dir",
        "{work_dir}",
        "--gpu",
        "{gpu}",
        "--truth-judge-dir",
        "{truth_judge_dir}",
        "--info-judge-dir",
        "{info_judge_dir}"
      ],
      "native_execute": true,
      "accept_folds": true,
      "required_fields": [
        "truth_judge_dir",
        "info_judge_dir"
      ],
      "depends_on": [
        "table1"
      ]
    },
    {
      "id": "table2",
      "title": "Independent training on generic tasks",
      "paper": "Table 2",
      "group": "main",
